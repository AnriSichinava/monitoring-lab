; {{ ansible_managed }}
; monitoring-lab / grafana role — main Grafana config

[server]
protocol = http
http_port = {{ grafana_listen_port }}
domain = {{ grafana_domain }}
root_url = {{ grafana_root_url }}

[security]
admin_user = {{ grafana_admin_username }}
; admin_password is NOT set here; rotated once via API in admin_password.yml (marker-idempotent)
allow_embedding = false
cookie_secure = false
disable_gravatar = true

[users]
allow_sign_up = false
default_theme = dark

[analytics]
reporting_enabled = false
check_for_updates = true

[log]
mode = console file
level = info

[plugins]
allow_loading_unsigned_plugins =
plugin_admin_enabled = true

[snapshots]
external_enabled = false
